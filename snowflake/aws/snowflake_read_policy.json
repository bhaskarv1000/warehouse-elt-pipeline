{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadRawObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion"],
      "Resource": "arn:aws:s3:::bhaskarv1000-warehouse-elt-raw/raw/*"
    },
    {
      "Sid": "ListRawPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::bhaskarv1000-warehouse-elt-raw",
      "Condition": { "StringLike": { "s3:prefix": ["raw/*"] } }
    },
    {
      "Sid": "FindBucketRegion",
      "Effect": "Allow",
      "Action": "s3:GetBucketLocation",
      "Resource": "arn:aws:s3:::bhaskarv1000-warehouse-elt-raw"
    }
  ]
}
